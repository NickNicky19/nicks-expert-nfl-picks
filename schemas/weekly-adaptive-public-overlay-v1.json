{
  "$id": "weekly-adaptive-public-overlay-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "DISABLED_USE_R0"
          }
        }
      },
      "then": {
        "properties": {
          "rows": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "properties": {
    "board_contract_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "canonical_board_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "display_board_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "fallback_counts": {
      "additionalProperties": {
        "minimum": 0,
        "type": "integer"
      },
      "propertyNames": {
        "enum": [
          "malformed_candidate",
          "candidate_outside_board_R0",
          "invalid_previous_overlay_R0",
          "started_R0_frozen_no_new_selection",
          "PPR_or_unsupported_R0",
          "publication_not_approved_R0",
          "missing_or_duplicate_candidate_R0",
          "incompatible_stale_or_late_R0"
        ]
      },
      "type": "object"
    },
    "frozen_rows": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "key": {
            "items": {
              "type": "string"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          },
          "row_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        },
        "required": [
          "key",
          "row_sha256"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "packaged_at": {
      "format": "date-time",
      "type": "string"
    },
    "prepared_at": {
      "format": "date-time",
      "type": "string"
    },
    "publication_review_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "registration_id": {
      "const": "weekly-adaptive-release-v1"
    },
    "rows": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "category": {
                  "enum": [
                    "pass_td",
                    "pass_cmp",
                    "pass_att",
                    "pass_int",
                    "rush_att",
                    "rec"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "forecast_value": {
                  "minimum": 0
                },
                "prediction_functional": {
                  "const": "expected_mean"
                },
                "product": {
                  "const": "point_mean"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "category": {
                  "enum": [
                    "pass_yd",
                    "rush_yd",
                    "rec_yd",
                    "rush_rec_yd"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "prediction_functional": {
                  "const": "intended_median"
                },
                "product": {
                  "const": "point_median"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "category": {
                  "const": "anytime_td"
                }
              }
            },
            "then": {
              "properties": {
                "forecast_value": {
                  "maximum": 1,
                  "minimum": 0
                },
                "prediction_functional": {
                  "const": "event_probability"
                },
                "product": {
                  "const": "binary_probability"
                }
              }
            }
          }
        ],
        "properties": {
          "category": {
            "enum": [
              "anytime_td",
              "pass_att",
              "pass_cmp",
              "pass_int",
              "pass_td",
              "pass_yd",
              "rec",
              "rec_yd",
              "rush_att",
              "rush_rec_yd",
              "rush_yd"
            ]
          },
          "first_prepared_at": {
            "format": "date-time",
            "type": "string"
          },
          "forecast_value": {
            "type": "number"
          },
          "game_id": {
            "minLength": 1,
            "type": "string"
          },
          "horizon": {
            "const": "player_game"
          },
          "issued_at": {
            "format": "date-time",
            "type": "string"
          },
          "kickoff_utc": {
            "format": "date-time",
            "type": "string"
          },
          "method_id": {
            "minLength": 1,
            "type": "string"
          },
          "model_version": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "persistence_completed_at": {
            "format": "date-time",
            "type": "string"
          },
          "player_id": {
            "minLength": 1,
            "type": "string"
          },
          "prediction_functional": {
            "enum": [
              "expected_mean",
              "intended_median",
              "event_probability"
            ]
          },
          "procedure_version": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "product": {
            "enum": [
              "point_mean",
              "point_median",
              "binary_probability"
            ]
          },
          "query_source_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "selection_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "source_cutoff_utc": {
            "format": "date-time",
            "type": "string"
          },
          "source_policy_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "valid_until_utc": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "category",
          "first_prepared_at",
          "forecast_value",
          "game_id",
          "horizon",
          "issued_at",
          "kickoff_utc",
          "method_id",
          "model_version",
          "persistence_completed_at",
          "player_id",
          "prediction_functional",
          "procedure_version",
          "product",
          "query_source_sha256",
          "selection_sha256",
          "source_cutoff_utc",
          "source_policy_sha256",
          "valid_until_utc"
        ],
        "type": "object"
      },
      "maxItems": 5000,
      "type": "array"
    },
    "schema_version": {
      "const": "weekly-adaptive-public-overlay-v1"
    },
    "season": {
      "maximum": 2200,
      "minimum": 2000,
      "type": "integer"
    },
    "state": {
      "enum": [
        "PROVISIONAL",
        "DISABLED_USE_R0"
      ]
    },
    "website_source_sha": {
      "pattern": "^[a-f0-9]{40}$",
      "type": "string"
    },
    "week": {
      "maximum": 18,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "board_contract_sha256",
    "canonical_board_sha256",
    "display_board_sha256",
    "fallback_counts",
    "frozen_rows",
    "packaged_at",
    "prepared_at",
    "publication_review_sha256",
    "registration_id",
    "rows",
    "schema_version",
    "season",
    "state",
    "website_source_sha",
    "week"
  ],
  "title": "Selected derived provisional forecasts only; exact PPR and point blends unsupported",
  "type": "object"
}
