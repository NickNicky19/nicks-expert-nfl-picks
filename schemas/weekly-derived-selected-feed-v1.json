{
  "$id": "weekly-derived-selected-feed-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "coverage": {
      "additionalProperties": false,
      "properties": {
        "fallback_counts": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "propertyNames": {
            "enum": [
              "private_ineligible_R0",
              "outside_board_R0",
              "started_R0"
            ]
          },
          "type": "object"
        },
        "private_selected_rows": {
          "maximum": 5000,
          "minimum": 1,
          "type": "integer"
        },
        "public_rows": {
          "maximum": 5000,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "private_selected_rows",
        "public_rows",
        "fallback_counts"
      ],
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "durability_receipt_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "identity_scope_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "producer_policy_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "r0_identity_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "rights_authority_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "rights_receipt_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "rows": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "category": {
                  "enum": [
                    "pass_td",
                    "pass_cmp",
                    "pass_att",
                    "pass_int",
                    "rush_att",
                    "rec"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "forecast_value": {
                  "minimum": 0
                },
                "prediction_functional": {
                  "const": "expected_mean"
                },
                "product": {
                  "const": "point_mean"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "category": {
                  "enum": [
                    "pass_yd",
                    "rush_yd",
                    "rec_yd",
                    "rush_rec_yd"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "prediction_functional": {
                  "const": "intended_median"
                },
                "product": {
                  "const": "point_median"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "category": {
                  "const": "anytime_td"
                }
              }
            },
            "then": {
              "properties": {
                "forecast_value": {
                  "maximum": 1,
                  "minimum": 0
                },
                "prediction_functional": {
                  "const": "event_probability"
                },
                "product": {
                  "const": "binary_probability"
                }
              }
            }
          }
        ],
        "properties": {
          "category": {
            "enum": [
              "anytime_td",
              "pass_att",
              "pass_cmp",
              "pass_int",
              "pass_td",
              "pass_yd",
              "rec",
              "rec_yd",
              "rush_att",
              "rush_rec_yd",
              "rush_yd"
            ]
          },
          "forecast_value": {
            "type": "number"
          },
          "game_id": {
            "minLength": 1,
            "type": "string"
          },
          "horizon": {
            "const": "player_game"
          },
          "issued_at": {
            "format": "date-time",
            "type": "string"
          },
          "kickoff_utc": {
            "format": "date-time",
            "type": "string"
          },
          "method_id": {
            "minLength": 1,
            "type": "string"
          },
          "model_version": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "persistence_completed_at": {
            "format": "date-time",
            "type": "string"
          },
          "player_id": {
            "minLength": 1,
            "type": "string"
          },
          "prediction_functional": {
            "enum": [
              "expected_mean",
              "intended_median",
              "event_probability"
            ]
          },
          "procedure_version": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "product": {
            "enum": [
              "point_mean",
              "point_median",
              "binary_probability"
            ]
          },
          "query_source_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "selection_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "source_cutoff_utc": {
            "format": "date-time",
            "type": "string"
          },
          "source_policy_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "valid_until_utc": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "category",
          "forecast_value",
          "game_id",
          "horizon",
          "issued_at",
          "kickoff_utc",
          "method_id",
          "model_version",
          "persistence_completed_at",
          "player_id",
          "prediction_functional",
          "procedure_version",
          "product",
          "query_source_sha256",
          "selection_sha256",
          "source_cutoff_utc",
          "source_policy_sha256",
          "valid_until_utc"
        ],
        "type": "object"
      },
      "maxItems": 5000,
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "weekly-derived-selected-feed-v1"
    },
    "season": {
      "type": "integer"
    },
    "state": {
      "const": "DERIVED_SELECTED_ONLY"
    },
    "week": {
      "maximum": 22,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "coverage",
    "created_at",
    "durability_receipt_sha256",
    "expires_at",
    "identity_scope_sha256",
    "producer_policy_sha256",
    "r0_identity_sha256",
    "rights_authority_sha256",
    "rights_receipt_sha256",
    "rows",
    "schema_version",
    "season",
    "state",
    "week"
  ],
  "type": "object"
}
